# Export privately; this project never reads another project's .env.
ANTHROPIC_API_KEY=
RELAY_MODEL=
# Live admission requires a separately inspected single-request cost estimate.
RELAY_ALLOW_LIVE=0
# Compose reads these values; runtime does not auto-load .env.
RELAY_POSTGRES_PASSWORD=
RELAY_ACCESS_TOKEN=
RELAY_PUBLIC_ORIGIN=
# Optional managed PostgreSQL queue; migration must run before startup.
# RELAY_DATABASE_URL=
# RELAY_STATE_DIR=
# RELAY_EMBEDDED_WORKER=0

# Optional owner-isolated account workspace; apply infrastructure/supabase migration first.
# RELAY_SUPABASE_URL=https://your-project.supabase.co
# RELAY_SUPABASE_PUBLISHABLE_KEY=
RELAY_ACCOUNT_SIGNUP=0
# Stable private report-signing secret, 48+ characters; keep out of source control.
# RELAY_REPORT_SIGNING_KEY=
